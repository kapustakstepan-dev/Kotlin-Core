<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.RegistroActivity"
    android:layout_margin="15dp"
    android:orientation="vertical"
    >

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/registro"
        android:layout_marginBottom="48dp"
        android:textSize="48dp"

        />

    <EditText
        android:id="@+id/editNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="introduze el nombre"
        android:layout_marginBottom="16dp"

        />
    <EditText
        android:id="@+id/editApellido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="introduze el apellido"
        android:layout_marginBottom="16dp"

        />
    <EditText
        android:id="@+id/editCorreo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="introduze el correo"
        android:layout_marginBottom="16dp"

        />
    <EditText
        android:id="@+id/editPass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="introduze el pass"
        android:layout_marginBottom="16dp"

        />
    <Spinner
        android:entries="@array/spiner_profile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/SpinerPerfil"
        android:layout_marginBottom="16dp"

        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:layout_width="0dp"
            android:layout_weight="0.5"
            android:layout_height="wrap_content"
            android:id="@+id/btnVolver"
            android:layout_marginRight="8dp"
            android:text="Volver"

            />
        <Button
            android:id="@+id/btnRegistarse"
            android:layout_width="0dp"
            android:layout_weight="0.5"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="Registrarse"

            />


    </LinearLayout>

</androidx.appcompat.widget.LinearLayoutCompat>